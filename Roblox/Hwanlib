	end
	window.GetFlag = function(self, name)
		return window.Flags[name]
	end
	window.SetFlag = function(self, name, val)
		if (window.Flags[name] and window.Flags[name].Set) then
			window.Flags[name].Set(val)
		else
			window.Flags[name] = {Value=val}
		end
	end
	window.SaveConfiguration = function(self)
		saveConfig()
	end
	window.LoadConfiguration = function(self)
		loadConfig()
	end
	local function oldDestroy()
		for _, inst in ipairs(window._dropdownInstances or {}) do
			pcall(function()
				if (inst and inst.Close) then
					inst.Close()
				end
			end)
		end
		if conns then
			for i = #conns, 1, -1 do
				local c = conns[i]
				pcall(function()
					if (c and c.Disconnect) then
						c:Disconnect()
					elseif (c and c.disconnect) then
						c:disconnect()
					end
				end)
				conns[i] = nil
			end
		end
		for i = #activeNotifs, 1, -1 do
			local e = activeNotifs[i]
			if (e and e.frame) then
				safeDestroy(e.frame)
			end
			activeNotifs[i] = nil
		end
		notifQueue = nil
		pcall(saveConfig)
		pcall(function()
			if (screenGui and screenGui.Parent) then
				screenGui:Destroy()
			end
		end)
		if (_G.Hwan and (_G.Hwan.screenGui == screenGui)) then
			_G.Hwan = nil
		end
		window.Flags = nil
		window._dropdownInstances = nil
		window._dropdownStates = nil
		window._savedState = nil
		refs = nil
		screenGui = nil
		Frame = nil
		HwanBtn = nil
		window = nil
	end
	window.Destroy = function(self)
		oldDestroy()
	end
	_G.Hwan = {screenGui=screenGui,conns=conns,auth=false}
	task.spawn(function()
		if cfg.HWIDSystem then
			if Frame then
				Frame.Visible = false
			end
			if HwanBtn then
				HwanBtn.Visible = false
			end
			createHWIDUI(function()
				_G.Hwan.auth = true
				if Frame then
					Frame.Visible = true
				end
				if HwanBtn then
					HwanBtn.Visible = cfg.ShowToggleIcon ~= false
				end
				tween(Frame, {Size=finalSize}, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				showNotification("Welcome to " .. (cfg.Title or "Hwan Hub"))
			end)
		else
			_G.Hwan.auth = true
			if Frame then
				Frame.Visible = true
			end
			if HwanBtn then
				HwanBtn.Visible = cfg.ShowToggleIcon ~= false
			end
			task.wait(0.06)
			tween(Frame, {Size=finalSize}, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
	end)
	task.defer(function()
		pcall(loadConfig)
	end)
	return window
end
Hwan.GetMyHWID = function(self)
	return self.HWID:GetEncryptedHWID()
end
Hwan.IsHWIDVerified = function(self)
	if (not self._config or not self._config.HWIDSystem) then
		return true
	end
	local hs = self._config.HWIDSettings or {}
	if not hs.HWIDLock then
		return true
	end
	local userHWID = self.HWID:GetEncryptedHWID()
	local allowedHWIDs = {}
	for _, hwid in ipairs(hs.HWIDList or {}) do
		allowedHWIDs[tostring(hwid)] = true
	end
	if (hs.HWIDUrl and (hs.HWIDUrl ~= "")) then
		local content = try_http_get(hs.HWIDUrl)
		if content then
			for line in content:gmatch("[^\r\n]+") do
				local hwid = line:gsub("^%s*(.-)%s*$", "%1")
				if (hwid ~= "") then
					allowedHWIDs[hwid] = true
				end
			end
		end
	end
	return allowedHWIDs[userHWID] or false
end
Hwan.AddHWIDToList = function(self, hwid)
	if (not self._config or not self._config.HWIDSettings) then
		return false
	end
	if not self._config.HWIDSettings.HWIDList then
		self._config.HWIDSettings.HWIDList = {}
	end
	table.insert(self._config.HWIDSettings.HWIDList, hwid)
	return true
end
Hwan.CopyHWID = function(self)
	local hwid = self:GetEncryptedHWID()
	local success = false
	local methods = {function()
		if setclipboard then
			setclipboard(hwid)
			return true
		end
	end,function()
		if toclipboard then
			toclipboard(hwid)
			return true
		end
	end,function()
		if write_clipboard then
			write_clipboard(hwid)
			return true
		end
	end,function()
		if (clipboard and (type(clipboard.set) == "function")) then
			clipboard.set(hwid)
			return true
		end
	end,function()
		return pcall(function()
			game:GetService("UserInputService"):SetClipboard(hwid)
		end)
	end}
	for _, method in ipairs(methods) do
		local ok, result = pcall(method)
		if (ok and result) then
			success = true
			break
		end
	end
	return success, hwid
end
return Hwan
