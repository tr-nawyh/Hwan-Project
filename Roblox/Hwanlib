		if not s then
			return
		end
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(s)
		end)
		if (not ok or (type(decoded) ~= "table")) then
			return
		end
		for flagName, val in pairs(decoded) do
			local meta = window.Flags[flagName]
