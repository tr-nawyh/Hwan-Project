	local function toggleVisible(newV)
		animCounter = animCounter + 1
		local token = animCounter
		visible = ((newV == nil) and not visible) or newV
		local animDur = 0.28
		local fadeDur = 0.12
		for i, inst in ipairs(window._dropdownInstances or {}) do
