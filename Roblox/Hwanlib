HWIDFunctions.GetEncryptedHWID = function(self)
	local hwid = self:GetHardwareID()
	if (hwid == "") then
		return "HWUNKNOWN"
	end
	if (#hwid > 36) then
		hwid = hwid:sub(1, 36)
	end
	local halfLength = math.floor(#hwid / 2)
	local firstHalf = hwid:sub(1, halfLength)
	local secondHalf = hwid:sub(halfLength + 1)
	local function stringToNumber(str)
		local total = 0
		for i = 1, #str do
			total = total + (string.byte(str, i) * (i ^ 2))
		end
		return total
	end
	local firstNum = stringToNumber(firstHalf)
	local secondNum = stringToNumber(secondHalf)
	local sqrtPart = math.sqrt(firstNum)
	sqrtPart = math.floor((sqrtPart * 100) + 0.5) / 100
	local numPart = secondNum % 1000000
	local encrypted = string.format("%.2f-%06d", sqrtPart, numPart)
	return encrypted
end
