			if not ((input.UserInputType == Enum.UserInputType.MouseButton1) or (input.UserInputType == Enum.UserInputType.Touch)) then
				return
			end
			if inputId then
				return
			end
			inputId = input
			dragging = false
			dragStart = input.Position
			startPos = main.Position
			targetPos = startPos
			moved = false
			moveConn = UserInputService.InputChanged:Connect(function(i)
				local isMatching = false
				if (i == input) then
					isMatching = true
				elseif ((input.UserInputType == Enum.UserInputType.MouseButton1) and (i.UserInputType == Enum.UserInputType.MouseMovement)) then
					isMatching = true
				elseif ((input.UserInputType == Enum.UserInputType.Touch) and (i.UserInputType == Enum.UserInputType.Touch)) then
					isMatching = true
				end
				if not isMatching then
					return
				end
				local delta = i.Position - dragStart
				if (not dragging and ((math.abs(delta.X) + math.abs(delta.Y)) > DRAG_THRESHOLD)) then
					dragging = true
				end
				if dragging then
					local desired = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
					targetPos = desired
					moved = true
				end
			end)
			trackWindowConn(moveConn)
			endConn = UserInputService.InputEnded:Connect(function(i)
				if ((i.UserInputType == input.UserInputType) or ((input.UserInputType == Enum.UserInputType.MouseButton1) and (i.UserInputType == Enum.UserInputType.MouseMovement))) then
					if moveConn then
						moveConn:Disconnect()
						moveConn = nil
					end
					if endConn then
						endConn:Disconnect()
						endConn = nil
					end
					inputId = nil
					dragging = false
					targetPos = UDim2.new(targetPos.X.Scale, math.floor(targetPos.X.Offset + 0.5), targetPos.Y.Scale, math.floor(targetPos.Y.Offset + 0.5))
				end
			end)
			trackWindowConn(endConn)
		end
		drag_bar.InputBegan:Connect(begin)
		drag_bar.AncestryChanged:Connect(function()
			if not drag_bar:IsDescendantOf(game) then
				dragging = false
				safeCall(function()
					if moveConn then
						moveConn:Disconnect()
					end
				end)
				safeCall(function()
