	local function reflowActivePositions()
		local cumOffset = 0
		local scale = 1
		if (Window._objects and Window._objects.ScreenGui) then
			local us = Window._objects.ScreenGui:FindFirstChildOfClass("UIScale")
			if (us and us.Scale) then
