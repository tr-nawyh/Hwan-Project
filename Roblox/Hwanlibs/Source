local function safeCall(func, ...)
	if (type(func) ~= "function") then
		return nil
	end
	local ok, res = pcall(func, ...)
	if not ok then
		warn("HwanLib Error:", res)
		return nil
	end
	return res
end
local activeWindows = {}
local activeConnections = {}
local function cleanupConnections()
	for _, connection in ipairs(activeConnections) do
		local ok, hasDisconnect = pcall(function()
			return connection and (type(connection.Disconnect) == "function")
		end)
		if (ok and hasDisconnect) then
			safeCall(function()
				connection:Disconnect()
			end)
		end
	end
	activeConnections = {}
end
local function isDisconnectable(obj)
	return obj and (type(obj) == "table") and (type(obj.Disconnect) == "function")
end
local function trackConnection(conn)
	if not conn then
		return conn
	end
	local okType, t = pcall(function()
		return typeof(conn)
	end)
	if (okType and (t == "RBXScriptConnection")) then
		table.insert(activeConnections, conn)
	elseif isDisconnectable(conn) then
		table.insert(activeConnections, conn)
	end
	return conn
end
local antiAfkConnection
local function setupAntiAFK()
	if not LocalPlayer then
		return
	end
	if antiAfkConnection then
		safeCall(function()
			antiAfkConnection:Disconnect()
			antiAfkConnection = nil
		end)
	end
	if ((type(VirtualUser) ~= "userdata") and (type(VirtualUser) ~= "table")) then
		return
	end
	local ok, idledEvent = pcall(function()
		return LocalPlayer and LocalPlayer.Idled
	end)
	if (not ok or not idledEvent) then
		return
	end
	antiAfkConnection = trackConnection(idledEvent:Connect(function()
		safeCall(function()
			pcall(function()
				local cam = workspace and workspace.CurrentCamera
				if (cam and cam.CFrame and VirtualUser) then
					VirtualUser:Button2Down(Vector2.new(0, 0), cam.CFrame)
					task.wait(1)
					VirtualUser:Button2Up(Vector2.new(0, 0), cam.CFrame)
				end
			end)
		end)
	end))
end
local function cleanupPrevious()
	safeCall(function()
		if LocalPlayer then
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if pg then
				local old = pg:FindFirstChild("hwanlib")
				if old then
					old:Destroy()
				end
			end
		end
	end)
	cleanupConnections()
