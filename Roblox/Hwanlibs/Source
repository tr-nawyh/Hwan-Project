			inputTypeActive = input
			dragStart = input.Position
			startOffset = Vector2.new(outer.Position.X.Offset, outer.Position.Y.Offset)
			targetOffset = startOffset
			moved = false
			toggleDragging = false
			moveConn = UserInputService.InputChanged:Connect(function(i)
				local isMatching = false
				if (i == input) then
					isMatching = true
				elseif ((input.UserInputType == Enum.UserInputType.MouseButton1) and (i.UserInputType == Enum.UserInputType.MouseMovement)) then
					isMatching = true
				elseif ((input.UserInputType == Enum.UserInputType.Touch) and (i.UserInputType == Enum.UserInputType.Touch)) then
					isMatching = true
				end
				if not isMatching then
					return
				end
				local delta = i.Position - dragStart
				if (not toggleDragging and ((math.abs(delta.X) + math.abs(delta.Y)) > DRAG_THRESHOLD)) then
					toggleDragging = true
				end
				if toggleDragging then
					local desired = Vector2.new(startOffset.X + delta.X, startOffset.Y + delta.Y)
					targetOffset = desired
					moved = true
				end
			end)
			trackWindowConn(moveConn)
			endConn = UserInputService.InputEnded:Connect(function(i)
				if ((i.UserInputType == input.UserInputType) or ((input.UserInputType == Enum.UserInputType.MouseButton1) and (i.UserInputType == Enum.UserInputType.MouseMovement))) then
					task.defer(function()
						if moveConn then
							moveConn:Disconnect()
							moveConn = nil
						end
						if endConn then
							endConn:Disconnect()
							endConn = nil
						end
						local wasMoved = moved
						toggleDragging = false
						inputTypeActive = nil
						moved = false
						targetOffset = Vector2.new(outer.Position.X.Offset, outer.Position.Y.Offset)
						if not wasMoved then
							toggleMainVisibility()
						end
					end)
				end
			end)
			trackWindowConn(endConn)
		end
		outer.InputBegan:Connect(beginInput)
		logo_image.InputBegan:Connect(beginInput)
		Window._toggleGui = tg
		table.insert(Window._auxObjects, tg)
	end
