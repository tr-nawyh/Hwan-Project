	local function centerLoading()
		local sgLocal = sg
		local scale = 1
		if sgLocal then
			local us = sgLocal:FindFirstChildOfClass("UIScale")
			if (us and us.Scale) then
				scale = us.Scale
			end
		end
		loading_root.AnchorPoint = Vector2.new(0.5, 0.5)
		loading_root.Position = UDim2.new(0.5, 0, 0.5, 0)
	end
	centerLoading()
	local camConn = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(centerLoading)
	trackWindowConn(camConn)
	local sg_us = sg:FindFirstChildOfClass("UIScale")
	if sg_us then
		local usconn = sg_us:GetPropertyChangedSignal("Scale"):Connect(centerLoading)
		trackWindowConn(usconn)
	end
	table.insert(Window._auxObjects, loading_root)
	local duration = LOADING_DURATION
	local percentUpdaterConn = RunService.Heartbeat:Connect(function()
		local frac = 0
		local sx = fill_1.Size and fill_1.Size.X and fill_1.Size.X.Scale
		if (sx and (type(sx) == "number")) then
			frac = math.clamp(sx, 0, 1)
		else
			local bgW = bar_1.AbsoluteSize.X
			local fillW = fill_1.AbsoluteSize.X
			if (bgW and (bgW > 0)) then
				frac = math.clamp(fillW / bgW, 0, 1)
			end
		end
		local px = math.floor((frac * 100) + 0.5)
		status_label.Text = tostring(px) .. "%"
	end)
	trackWindowConn(percentUpdaterConn)
	local function startProgressTween()
		if (not bar_1.AbsoluteSize or (bar_1.AbsoluteSize.X <= 0)) then
			local connWait = RunService.Heartbeat:Connect(function()
				if (bar_1.AbsoluteSize and (bar_1.AbsoluteSize.X > 0)) then
					connWait:Disconnect()
					startProgressTween()
				end
			end)
			return
		end
		fill_1.Size = UDim2.new(0, 0, 1, 0)
		local progTween = TweenService:Create(fill_1, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
			Size = UDim2.new(1, 0, 1, 0)
		})
		progTween:Play()
		progTween.Completed:Connect(function()
			task.defer(function()
				task.wait(1)
				safeCall(function()
					if (loading_root and loading_root.Parent) then
						loading_root:Destroy()
					end
				end)
				createShowButton()
				safeCall(function()
					main.Visible = true
				end)
				safeCall(function()
					Window:Notify({
						Title = (LOADING_TITLE or opts.Title or "Title"),
						Content = "Successfully loaded!",
						Duration = 2
					})
				end)
			end)
		end)
	end
	startProgressTween()
	close_button.MouseButton1Click:Connect(function()
		safeCall(function()
			Window:Destroy()
		end)
	end)
	minimize_button.MouseButton1Click:Connect(function()
		if (Window._toggleGui and Window._toggleGui.Parent) then
			if sg then
				sg.Enabled = false
			end
			main.Visible = false
			return
		end
		if sg then
			sg.Enabled = false
		end
		main.Visible = false
		createShowButton()
	end)
	if opts.ToggleUIKeybind then
		local expected = tostring(opts.ToggleUIKeybind)
		local keyToggleConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then
				return
			end
			if ((input.UserInputType == Enum.UserInputType.Keyboard) and input.KeyCode and (input.KeyCode.Name == expected)) then
				if (sg and sg.Enabled and main.Visible) then
					sg.Enabled = false
					main.Visible = false
					if not (Window._toggleGui and Window._toggleGui.Parent) then
						createShowButton()
					end
				elseif (Window._toggleGui and Window._toggleGui.Parent) then
					if sg then
						sg.Enabled = true
					end
					main.Visible = true
				else
					if sg then
						sg.Enabled = true
					end
					main.Visible = true
					createShowButton()
				end
			end
		end)
		trackWindowConn(keyToggleConn)
	end
	Window._objects.DropdownBorder.Visible = false
	table.insert(Window._auxObjects, dropdown_panel)
	return Window
end
Hwanlib.Themes = ThemeManager
Hwanlib.ThemeManager = {
	GetTheme = function(name)
		return ThemeManager[name] or ThemeManager.Default
	end,
	AddTheme = function(name, themeTable)
		if ((type(name) == "string") and (type(themeTable) == "table")) then
			ThemeManager[name] = themeTable
		end
	end,
	RemoveTheme = function(name)
		if (name ~= "Default") then
			ThemeManager[name] = nil
		end
	end
}
return Hwanlib
