			if (us and us.Scale) then
				scale = us.Scale
			end
		end
		local finalX = pos.X + size.X + 12
		local finalY = pos.Y
		local unscaledX = math.floor((finalX / scale) + 0.5)
		local unscaledY = math.floor((finalY / scale) + 0.5)
		safeCall(function()
