local function New(class, props)
	local obj = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if (k == "Parent") then
				obj.Parent = v
			else
				safeCall(function()
					obj[k] = v
				end)
			end
		end
	end
	return obj
end
