local function measureText(text, size, maxWidth)
	size = size or 14
	local constraint = Vector2.new(2000, 2000)
	if (maxWidth and (type(maxWidth) == "number")) then
		constraint = Vector2.new(maxWidth, 2000)
	end
	return TextService:GetTextSize(text, size, FONT, constraint)
end
local function truncateString(s, n)
	s = tostring(s or "")
	if ((type(utf8) == "table") and (type(utf8.len) == "function")) then
		local total = utf8.len(s)
		if (total and (total > n)) then
			local nextPos = utf8.offset(s, n + 1)
			if nextPos then
				return s:sub(1, nextPos - 1)
			else
				return s
			end
		end
		return s
	else
		if (#s > n) then
			return s:sub(1, n)
		end
		return s
	end
end
local function canWriteFile()
	return (type(writefile) == "function") and (type(readfile) == "function")
end
local function safeWriteFile(path, content)
	if canWriteFile() then
		safeCall(writefile, path, content)
	end
end
local function safeReadFile(path)
	if canWriteFile() then
		local content = safeCall(readfile, path)
		return content
	end
	return nil
end
