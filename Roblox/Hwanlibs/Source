				TextColor3 = Color3.fromRGB(0, 0, 0),
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Left
			})
			local sliderContainer = New("Frame", {
				Parent = f,
				BackgroundTransparency = 1,
				Position = UDim2.new(0.5, 0, 0, 5),
				Size = UDim2.new(0.5, -RIGHT_PAD, 0, 25)
			})
			local barFrame = New("Frame", {
				Parent = sliderContainer,
				BackgroundColor3 = selectedTheme.ButtonDark,
				BorderSizePixel = 0,
				Position = UDim2.new(0, 0, 0.5, -3),
				Size = UDim2.new(0.7, 0, 0, 6)
			})
			New("UICorner", {
				Parent = barFrame,
				CornerRadius = CORNER_RADIUS
			})
			local fill = New("Frame", {
				Parent = barFrame,
				BackgroundColor3 = selectedTheme.ButtonOn,
				BorderSizePixel = 0,
				Size = UDim2.new((cur - minV) / ((maxV - minV) + 0.0001), 0, 1, 0)
			})
			New("UICorner", {
				Parent = fill,
				CornerRadius = CORNER_RADIUS
			})
			local knob = New("Frame", {
				Parent = barFrame,
				BackgroundColor3 = selectedTheme.ButtonText,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 12, 0, 12),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0),
				ZIndex = 2
			})
			New("UICorner", {
				Parent = knob,
				CornerRadius = CORNER_RADIUS
			})
			local valueBox = New("TextBox", {
				Parent = sliderContainer,
				BackgroundColor3 = selectedTheme.ButtonDark,
				BorderSizePixel = 0,
				Position = UDim2.new(0.72, 5, 0, 0),
				Size = UDim2.new(0.28, -5, 1, 0),
				Font = FONT,
				Text = tostring(cur),
				TextColor3 = selectedTheme.ButtonText,
				TextSize = 14,
				ClearTextOnFocus = false
			})
			New("UICorner", {
				Parent = valueBox,
				CornerRadius = CORNER_RADIUS
			})
			valueBox.TextXAlignment = Enum.TextXAlignment.Center
			local dragging = false
			local function clamp(n, a, b)
				return math.max(a, math.min(b, n))
			end
			local function snapToIncrement(n)
				if (inc and (inc > 0)) then
					local steps = math.floor(((n - minV) / inc) + 0.5)
					local snapped = minV + (steps * inc)
					if (snapped < minV) then
						snapped = minV
					end
					if (snapped > maxV) then
						snapped = maxV
					end
					return snapped
				end
				return n
			end
			local function setValueInternal(newVal, skipCallback, smooth)
				newVal = tonumber(newVal) or cur
				newVal = clamp(newVal, minV, maxV)
				newVal = snapToIncrement(newVal)
				cur = newVal
				local frac2 = (cur - minV) / ((maxV - minV) + 0.0001)
				if smooth then
					safeCall(function()
						TweenService:Create(fill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Size = UDim2.new(frac2, 0, 1, 0)
						}):Play()
						TweenService:Create(knob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Position = UDim2.new(frac2, 0, 0.5, 0)
						}):Play()
					end)
				else
					fill.Size = UDim2.new(frac2, 0, 1, 0)
					knob.Position = UDim2.new(frac2, 0, 0.5, 0)
				end
				if (valueBox and (valueBox.Text ~= "...")) then
					valueBox.Text = tostring(math.floor((cur * 100) + 0.5) / 100)
				end
				if (opts.Flag and CONFIG.Enabled) then
					Window._config[opts.Flag] = cur
					Window:SaveConfig()
				end
				if (opts.Callback and not skipCallback) then
					safeCall(opts.Callback, cur)
				end
			end
			local function setValueFromPosition(x)
				local abs = barFrame.AbsoluteSize.X
				local rel = clamp(x - barFrame.AbsolutePosition.X, 0, abs)
				local frac = rel / (((abs == 0) and 1) or abs)
				local raw = minV + (frac * (maxV - minV))
				local snapped = snapToIncrement(raw)
				setValueInternal(snapped)
			end
			local function handleInputBegan(input)
				if ((input.UserInputType == Enum.UserInputType.MouseButton1) or (input.UserInputType == Enum.UserInputType.Touch)) then
					dragging = true
					local mousePos = input.Position
					setValueFromPosition(mousePos.X)
				end
			end
			local function handleInputChanged(input)
				if not dragging then
					return
				end
				if ((input.UserInputType == Enum.UserInputType.MouseMovement) or (input.UserInputType == Enum.UserInputType.Touch)) then
					local mousePos = input.Position
					setValueFromPosition(mousePos.X)
				end
			end
			local function handleInputEnded(input)
				if (dragging and ((input.UserInputType == Enum.UserInputType.MouseButton1) or (input.UserInputType == Enum.UserInputType.Touch) or (input.UserInputType == Enum.UserInputType.MouseMovement))) then
					dragging = false
					setValueInternal(cur, true, true)
				end
			end
			barFrame.InputBegan:Connect(handleInputBegan)
			knob.InputBegan:Connect(handleInputBegan)
			local inputChangedConn = UserInputService.InputChanged:Connect(handleInputChanged)
			trackWindowConn(inputChangedConn)
			local inputEndedConn = UserInputService.InputEnded:Connect(handleInputEnded)
			trackWindowConn(inputEndedConn)
			f.AncestryChanged:Connect(function()
				if not f:IsDescendantOf(game) then
					safeCall(function()
						if inputChangedConn then
							inputChangedConn:Disconnect()
						end
						if inputEndedConn then
							inputEndedConn:Disconnect()
						end
					end)
				end
			end)
			local function sanitizeTextForNumber(txt)
				if not txt then
					return ""
				end
				local allowed = txt:gsub("[^0-9%.%-]", "")
				local out = ""
				local seenDot = false
				for i = 1, #allowed do
					local ch = allowed:sub(i, i)
					if (ch == ".") then
						if not seenDot then
							seenDot = true
							out = out .. "."
						end
					elseif (ch == "-") then
						if (out == "") then
							out = out .. "-"
						end
					else
						out = out .. ch
					end
				end
				return out
			end
			valueBox.Focused:Connect(function()
				valueBox.Text = ""
			end)
			local textChangedConn = valueBox:GetPropertyChangedSignal("Text"):Connect(function()
				local txt = valueBox.Text or ""
				local cleaned = sanitizeTextForNumber(txt)
				if (cleaned ~= txt) then
					valueBox.Text = cleaned
				end
			end)
			trackWindowConn(textChangedConn)
			valueBox.FocusLost:Connect(function(enter)
				local raw = tostring(valueBox.Text or "")
				local sanitized = sanitizeTextForNumber(raw)
				if ((sanitized == "") or (sanitized == "-") or (sanitized == ".")) then
					if (valueBox and (valueBox.Text ~= "...")) then
						valueBox.Text = tostring(math.floor((cur * 100) + 0.5) / 100)
					end
					return
				end
				local n = tonumber(sanitized)
				if n then
					if (n < minV) then
						n = minV
					end
					if (n > maxV) then
						n = maxV
					end
					n = snapToIncrement(n)
					setValueInternal(n)
				elseif (valueBox and (valueBox.Text ~= "...")) then
					valueBox.Text = tostring(math.floor((cur * 100) + 0.5) / 100)
				end
			end)
			if (opts.Flag and CONFIG.Enabled and (Window._config[opts.Flag] ~= nil)) then
				cur = tonumber(Window._config[opts.Flag]) or cur
				setValueInternal(cur, true)
			end
			local obj = {
				_frame = f,
				_label = label,
				_value = function()
					return cur
				end
			}
			obj.Set = function(self, val)
				val = tonumber(val) or cur
				setValueInternal(val)
			end
			return obj
		end
