				if finished then
					return
				end
				finished = true
				safeCall(function()
					local outTween = TweenService:Create(gui.Border, TweenInfo.new(0.2), {
						Position = UDim2.new(1, NotifyManager.offscreenX, 1, -NotifyManager.bottomMargin)
					})
					outTween.Completed:Connect(function()
						safeCall(function()
							gui.Border:Destroy()
						end)
					end)
					outTween:Play()
				end)
				removeActive(gui)
				task.delay(0.06, reflowActivePositions)
				task.delay(0.12, processQueue)
			end)
			fillTween:Play()
			gui.Close.MouseButton1Click:Connect(function()
