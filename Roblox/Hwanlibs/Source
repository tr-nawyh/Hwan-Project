local LocalPlayer = Players.LocalPlayer
local function getLocalPlayer(timeout)
	timeout = tonumber(timeout) or 0
	if (Players and Players.LocalPlayer) then
		return Players.LocalPlayer
	end
	if (timeout <= 0) then
		return nil
	end
	local start = tick()
	while (tick() - start) < timeout do
		if (Players and Players.LocalPlayer) then
			return Players.LocalPlayer
		end
		task.wait(0.05)
	end
	return nil
end
local function refreshLocalPlayer()
	LocalPlayer = Players.LocalPlayer
	return LocalPlayer
end
if not LocalPlayer then
	spawn(function()
		for i = 1, 200 do
			if (Players and Players.LocalPlayer) then
				LocalPlayer = Players.LocalPlayer
				break
			end
			task.wait(0.05)
		end
	end)
end
