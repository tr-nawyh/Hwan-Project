		Tab.CreateSlider = function(self, opts)
			opts = opts or {}
			local minV = tonumber(opts.Min) or 0
			local maxV = tonumber(opts.Max) or 100
			local inc = tonumber(opts.Increment) or 1
			local cur = tonumber(opts.CurrentValue) or minV
			local f = elementFrame()
			local label = New("TextLabel", {
				Parent = f,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, LEFT_PAD, 0, 5),
				Size = UDim2.new(0.45, 0, 0, 22),
