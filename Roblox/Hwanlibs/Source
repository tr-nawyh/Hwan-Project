			end
		end
		local effectiveGap = math.max(6, math.floor(NotifyManager.gap / (scale or 1)))
		for i, n in ipairs(NotifyManager.active) do
			local absH = (n.Border and n.Border.AbsoluteSize and n.Border.AbsoluteSize.Y) or n.Border.Size.Y.Offset
			local absHUnscaled = math.floor((absH / (scale or 1)) + 0.5)
			local targetPos = UDim2.new(1, -NotifyManager.rightMargin, 1, -(NotifyManager.bottomMargin + cumOffset))
			safeCall(function()
				TweenService:Create(n.Border, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = targetPos
				}):Play()
			end)
			cumOffset = cumOffset + absHUnscaled + effectiveGap
		end
	end
	local function processQueue()
		while (#NotifyManager.active < NotifyManager.maxActive) and (#NotifyManager.queue > 0) do
			local opts = table.remove(NotifyManager.queue, 1)
			local gui = createNotifyGui(opts)
			gui.Title.Text = opts.Title or gui.Title.Text
			gui.Content.Text = opts.Content or gui.Content.Text
			local paddingX = 24
			local minW, maxW = 120, 600
			local titleW = measureText(gui.Title.Text, 18).X
			local contentW = measureText(gui.Content.Text, 13).X
			local width = math.clamp(math.max(titleW, contentW) + paddingX, minW, maxW)
			local height = NotifyManager.defaultHeight
			gui.Border.Size = UDim2.new(0, width, 0, height)
			gui.Border.Visible = true
			gui.Title.Size = UDim2.new(0, math.max(0, width - paddingX), 0, 18)
			gui.Title.Position = UDim2.new(0.06, 0, 0.12, 0)
			gui.Content.TextWrapped = false
			gui.Content.Position = UDim2.new(0.06, 0, 0.39, 0)
			gui.Content.Size = UDim2.new(0, math.max(0, width - paddingX), 0, 20)
			gui.Border.Position = UDim2.new(1, NotifyManager.offscreenX, 1, -NotifyManager.bottomMargin)
			table.insert(NotifyManager.active, 1, gui)
			reflowActivePositions()
			local showTween = TweenService:Create(gui.Border, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(1, -NotifyManager.rightMargin, 1, -NotifyManager.bottomMargin)
			})
			showTween:Play()
			local duration = gui.Duration or 4
			local finished = false
			local fillTween = TweenService:Create(gui.Fill, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 0, 1, 0)
			})
